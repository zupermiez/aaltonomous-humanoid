# Build the repository's Isaac Sim 6.2 + Isaac Lab 3.0 scene image on the GPU host.
AALTO_IMAGE=aalto-sim-verda:v1
AALTO_HOST_DATA=/opt/aalto-verda/data
TASK=Aalto-Sort-G129-Dex3-Joint
GPU_DEVICE=all
DISPLAY=:0

# Optional: use Aalto-Insert-G129-Dex3-Joint for the sorting + lid scene.
# TASK=Aalto-Insert-G129-Dex3-Joint
# Optional simulation variants: AALTO_DR=train or AALTO_INSTANCE=b.
AALTO_DR=
AALTO_INSTANCE=

# Used by setup-instance.sh. Replace with your laptop's public IP/32.
# Leave empty until confirmed; UFW will allow SSH only from this CIDR.
CLIENT_CIDR=
